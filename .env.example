# ── 运行模式 ──────────────────────────────────────────────────
# 默认模拟。实单必须同时设置 DRY_RUN=0 和 ENABLE_REAL_ORDERS=I_UNDERSTAND_REAL_MONEY。
DRY_RUN=1
ENABLE_REAL_ORDERS=

# 运行时文件目录：socket、日志、库存都会写到这里。
BOT_RUN_DIR=run

# 市场标识。
MARKET_SLUG=btc-updown-5m

# 行情来源：sim=本地模拟；live=Polymarket market WS + Binance BTC WS。
DATA_MODE=sim

# 自动发现当前 5 分钟 BTC Up/Down 市场。开启后不需要手填 token，每轮自动切换。
AUTO_DISCOVER_MARKET=1
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
MARKET_WINDOW_SECS=300
MARKET_DISCOVERY_MS=2000
MARKET_SWITCH_GRACE_MS=90000

# AUTO_DISCOVER_MARKET=0 时才手动填写当前 5 分钟市场的 Up/Down CLOB token id。
POLYMARKET_UP_TOKEN_ID=
POLYMARKET_DOWN_TOKEN_ID=
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_REST_URL=https://api.binance.com

# 真实 CLOB 下单配置。不要把私钥提交到 GitHub。
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=
# eoa / proxy / gnosis_safe / poly1271。多数 Polymarket 账户/代理钱包用 proxy。
POLY_SIGNATURE_TYPE=proxy
POLY_FUNDER_ADDRESS=

# AUTO_DISCOVER_MARKET=0 时手动填写判定价/开盘价；自动发现会用 Binance 开盘成交价兜底。
PRICE_TO_BEAT=68000

# ── 二元做市参数 ──────────────────────────────────────────────
# 每次单边挂单份数。
QUOTE_SIZE=5

# 做市毛价差：up_bid + down_bid <= 1 - QUOTE_SPREAD。
QUOTE_SPREAD=0.04

# 未成交报价在风控里保留多久。过期后释放 pending 库存。
QUOTE_TTL_MS=1500

# 新报价和旧报价差多少 tick 才撤旧换新；0 表示每次都换。
REQUOTE_THRESHOLD_TICKS=1

# 库存偏移强度：某边库存多时压低该边买价、抬高对边买价。
INVENTORY_SKEW=0.03

# 单边最大库存倍数：单边最大库存 = QUOTE_SIZE * INVENTORY_MULT。
INVENTORY_MULT=2

# 最低/最高挂买价，避免极端价格或追贵。
MIN_BID=0.05
MAX_BID=0.62

# Polymarket 二元合约常用价格 tick。
TICK_SIZE=0.01

# ── 模拟行情参数 ──────────────────────────────────────────────
# BTC 相对开盘价偏移转概率时使用的噪声尺度。后面接真实模型后可替换。
BTC_SIGMA_USD=35

# order-gateway 模拟成交概率。只用于 DRY_RUN 骨架测试。
SIM_FILL_CHANCE=0.18

# ── Kill switch ───────────────────────────────────────────────
# 最坏结算情景亏损达到该值就停止。
MAX_LOSS=25

# Up+Down 已成交+pending 总库存达到该值就停止。
MAX_TOTAL_INVENTORY=50

# 真实下单单笔名义金额上限。当前 DRY_RUN 也会按它截断模拟挂单。
LIVE_ORDER_NOTIONAL_CAP=5

# ── 进程节奏 ──────────────────────────────────────────────────
# 模拟 collector 产生行情的间隔。真实 WS 接入后主要由事件驱动。
MARKET_INTERVAL_MS=120

# 行情超过此毫秒数视为过期，quote-engine 会跳过。
STALE_AFTER_MS=800

# live WS 超过多久没有更新就触发停止信号，毫秒。
WS_STALE_AFTER_MS=10000

# ── 策略大脑 v3：时间感知定价 / 自适应波动率 / 残局 / 逆选择 ──────
# 核心思想：5 分钟二元 = 数字期权，唯一关键量是剩余不确定性 W=σ_$·√τ。
# 时间越少 W 越小，公允价越接近 0/1。下面参数控制这套大脑。

# BTC 美元波动率初值(σ_$，每√秒)。热身前用，之后由实时成交自适应。
VOL_SEED_PER_SQRT_SEC=6
# 波动率 EWMA 半衰期(秒)，越小越灵敏。
VOL_HALFLIFE_SEC=20
# 波动率估计的下/上限钳制。
VOL_MIN_PER_SQRT_SEC=1.5
VOL_MAX_PER_SQRT_SEC=60
# 收盘前 W 的下限(美元)，避免除零与无限 gamma。
WIDTH_FLOOR_USD=3

# 基础半价差(价格单位)。
BASE_HALF_SPREAD=0.012
# 双边成交锁利下限：up_bid + down_bid <= 1 - MIN_LOCK_EDGE。
MIN_LOCK_EDGE=0.02
# 你的撤改单延迟(秒)。越大，逆选择保护溢价越高。
LATENCY_SEC=0.4
# 逆选择价差强度。贴判定价且临近收盘时会自动拉宽。
K_ADVERSE=1
# 半价差上下限钳制。
MIN_HALF_SPREAD=0.005
MAX_HALF_SPREAD=0.25

# 残局协议：剩余秒数 < REDUCE 只挂减仓单；< PULL 撤掉所有单。
ENDGAME_REDUCE_SECS=60
ENDGAME_PULL_SECS=12
# 库存偏移随临近收盘加码的倍数。
INVENTORY_SKEW_TIME_BOOST=2

# 逆选择(toxicity)监控：成交后公允价持续对我们不利就自动加宽价差。
TOX_HORIZON_MS=2500
TOX_DECAY=0.5
TOX_K_WIDEN=1.5
TOX_MAX_WIDEN=0.08

# Delta 对冲：当前仅占位骨架，未接真实交易所，实单模式禁止开启。
ENABLE_DELTA_HEDGE=0
HEDGE_VENUE=binance_perp
