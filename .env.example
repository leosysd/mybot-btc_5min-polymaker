# ════════════════════════════════════════════════════════════════
#  polymaker .env 配置 — BTC 5 分钟二元市场做市机器人(value-buy 版)
#  实单三要素缺一不可: DRY_RUN=0 + ENABLE_REAL_ORDERS=确认串 + DATA_MODE=live
#  私钥只放 VPS 本地,绝不提交 GitHub。
# ════════════════════════════════════════════════════════════════

# ── 运行模式与安全开关 ────────────────────────────────────────────
DRY_RUN=1               # 1=只模拟不下单;0=允许实单(还需下面的确认串)。
ENABLE_REAL_ORDERS=     # 实单确认串:必须填 I_UNDERSTAND_REAL_MONEY 才会真下单。
DATA_MODE=sim           # sim=本地模拟行情;live=Polymarket WS + 币安 WS 真实行情。
BOT_RUN_DIR=run         # 运行时目录(socket/日志/库存),相对路径基于安装目录。

# ── 市场自动发现 ──────────────────────────────────────────────────
MARKET_SLUG=btc-updown-5m     # 市场 slug 前缀,完整 slug = 前缀-{窗口起始unix秒}。
AUTO_DISCOVER_MARKET=1        # 1=每窗口自动发现并切换市场;0=手填下面两个 token。
MARKET_WINDOW_SECS=300        # 窗口长度(秒):BTC 5 分钟盘 = 300。
MARKET_DISCOVERY_MS=2000      # 自动发现轮询间隔(毫秒)。
MARKET_SWITCH_GRACE_MS=90000  # 换盘宽限(毫秒),窗口边界的 WS 开盘价捕获窗口由它推导。
POLYMARKET_UP_TOKEN_ID=       # 手动模式的 Up token id(自动发现时留空)。
POLYMARKET_DOWN_TOKEN_ID=     # 手动模式的 Down token id(自动发现时留空)。
PRICE_TO_BEAT=68000           # 手动/模拟模式判定价;自动发现用币安 1 分钟 K 线开盘价。

# ── 服务端点(一般不用改) ──────────────────────────────────────────
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com                    # 市场元数据查询(自动发现用)。
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market       # Polymarket 盘口行情 WS。
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user    # Polymarket 成交/撤单回报 WS(实单)。
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade                # 币安逐笔成交流:模型实时价 S 的唯一来源。
BINANCE_REST_URL=https://api.binance.com                                     # 币安 REST:启动种子价、WS 断线兜底、判定价 K 线。
POLYMARKET_CLOB_HOST=https://clob.polymarket.com                             # Polymarket CLOB 下单主机。

# ── Polymarket 账户(实单必填) ─────────────────────────────────────
POLY_CHAIN_ID=137           # Polygon 主网 = 137。
POLY_PRIVATE_KEY=           # 钱包私钥(只放 VPS 本地,绝不提交 GitHub)。
POLY_API_KEY=               # L2 API key,留空则用私钥自动创建/派生。
POLY_SECRET=                # L2 secret,同上。
POLY_PASSPHRASE=            # L2 passphrase,同上。
POLY_SIGNATURE_TYPE=poly1271 # eoa/proxy/gnosis_safe/poly1271;deposit wallet 通常用 poly1271。
POLY_FUNDER_ADDRESS=         # poly1271 填 deposit wallet/funder;不要填设置页"仅供API"的签名地址。

# ── 报价策略(value-buy 做市) ──────────────────────────────────────
QUOTE_SIZE=5               # 每次单边挂单份数。
VALUE_MIN_EDGE=0.03        # 最低安全垫:买价 <= 模型 fair - 该值,0.03=至少 3 美分 edge。
VALUE_AGGRESSION_TICKS=1   # 在买一价上抬几个 tick 抢队列(仍受 edge 和 post-only 约束)。
VALUE_MIN_FAIR=0.05        # 模型胜率低于该值的一边不挂单(不碰深度劣势方)。
ENABLE_MARKET_ANCHOR=0     # 1=真实报价使用盘口锚定融合胜率;默认0只用模型。
MARKET_ANCHOR_SHADOW=1     # 1=只记录盘口锚定影子胜率,不改变实盘报价。
MARKET_ANCHOR_WEIGHT=0.30  # 盘口胜率最大融合权重;盘口越窄实际权重越接近该值。
MARKET_ANCHOR_MAX_SPREAD=0.12 # 盘口最大健康价差;超过则盘口锚定权重降为0。
QUOTE_WARMUP_SECS=25       # 开盘静默期(秒):窗口头 N 秒不报价,避开知情流。0=关。
ENDGAME_PULL_SECS=12       # 残局:剩余秒数 < 该值撤掉所有挂单,不再报价。
MIN_BID=0.05               # 最低挂买价,不挂垃圾深度价。
MAX_BID=0.62               # 最高挂买价,不追贵。
TICK_SIZE=0.01             # 价格最小变动单位(Polymarket 二元盘常用 0.01)。

# ── 挂单生命周期 ──────────────────────────────────────────────────
QUOTE_TTL_MS=1500           # 挂单存活时间(毫秒):到期撤单并释放 pending 库存。
REQUOTE_THRESHOLD_TICKS=1   # 新旧报价差 >= 该 tick 数才撤旧换新,减少无效撤单。
POST_ONLY_MARGIN_TICKS=2    # 买价至少低于卖一这么多 tick,防 "crosses book" 拒单。
REJECT_BACKOFF_MS=500       # 同边被拒单后的冷却(毫秒),防空转刷 400 被限流。0=关。

# ── 库存与锁利 ────────────────────────────────────────────────────
INVENTORY_MULT=2              # 单边最大库存 = QUOTE_SIZE × 此值(含 pending)。
MAX_UNPAIRED_SHARES=19        # 最大未配平差额;超过后只允许挂落后的一边。0=关闭。
INVENTORY_SKEW=0.03           # 库存偏移强度:多的一边压低买价、少的一边抬高买价。
INVENTORY_SKEW_TIME_BOOST=2   # 偏移随临近收盘放大的倍数(尾盘带着单边仓更危险)。
MIN_LOCK_EDGE=0.02            # 锁利下限:up_bid + down_bid <= 1 - 该值;补腿价也受其约束。

# ── 公允价模型(W = σ·√τ 时间感知定价) ─────────────────────────────
VOL_SEED_PER_SQRT_SEC=6    # σ_$ 初值(美元/√秒),波动率估计热身前使用。
VOL_HALFLIFE_SEC=20        # 波动率 EWMA 半衰期(秒),越小对突变越灵敏。
VOL_MIN_PER_SQRT_SEC=1.5   # 波动率估计下限钳制。
VOL_MAX_PER_SQRT_SEC=60    # 波动率估计上限钳制。
WIDTH_FLOOR_USD=3          # W 的下限(美元),收盘前防除零和无限 gamma。
BASE_HALF_SPREAD=0.012     # 基础半价差(价格单位)。
MIN_HALF_SPREAD=0.005      # 半价差下限钳制。
MAX_HALF_SPREAD=0.25       # 半价差上限钳制。
LATENCY_SEC=0.4            # 自身撤改单延迟(秒):越大,逆选择保护溢价越宽。
K_ADVERSE=1                # 逆选择加宽强度:贴判定价且临近收盘时自动拉宽价差。

# ── 逆选择监控(toxicity) ──────────────────────────────────────────
TOX_HORIZON_MS=2500   # 成交后多久结算 markout(毫秒):看 fair 是否对我们不利。
TOX_DECAY=0.5         # markout EWMA 衰减系数(0~1),越大记忆越长。
TOX_K_WIDEN=1.5       # 毒性 → 价差加宽的放大系数。
TOX_MAX_WIDEN=0.08    # 毒性加宽上限(价格单位)。

# ── 风控 kill switch ──────────────────────────────────────────────
MAX_LOSS=25                 # 最坏结算情景亏损达该值(美元)就停机。0=关。
MAX_TOTAL_INVENTORY=50      # Up+Down 已成交+pending 总库存达该值就停机。0=关。
LIVE_ORDER_NOTIONAL_CAP=5   # 实单单笔名义上限(美元);DRY_RUN 也按它截断模拟挂单。
STALE_AFTER_MS=800          # 行情帧超龄(毫秒)即跳过;其 5 倍(夹 2.5~6s)为币安 WS 判死阈值。
WS_STALE_AFTER_MS=10000     # 行情静默超该毫秒数触发停机(自动发现模式由 collector 接管)。

# ── 实盘对账与连接保活 ────────────────────────────────────────────
RECONCILE_INTERVAL_MS=30000   # 周期对账:拉真实挂单、撤掉本地不认识的孤儿单(毫秒)。0=关。
ENABLE_PREWARM=1              # 1=开新盘时预热 token 缓存 + 周期 ping CLOB 保持热连接。
PREWARM_INTERVAL_MS=60000     # 保活间隔(毫秒):Cloudflare 约 90s 掐空闲连接,需小于它。

# ── 模拟模式专用 ──────────────────────────────────────────────────
SIM_FILL_CHANCE=0.18     # 模拟成交概率(仅 DRY_RUN 本地撮合用)。
MARKET_INTERVAL_MS=120   # 模拟行情生成间隔(毫秒);live 模式事件驱动,不用它。

# ── 占位功能(未实现,勿开) ─────────────────────────────────────────
ENABLE_DELTA_HEDGE=0       # Delta 对冲占位:未接真实交易所,实单模式禁止开启。
HEDGE_VENUE=binance_perp   # 对冲场所占位。

# ── 遗留参数(当前代码未引用,仅兼容保留) ───────────────────────────
QUOTE_SPREAD=0.04   # [未使用] 旧版做市毛价差,重构后代码不再读取。
BTC_SIGMA_USD=35    # [未使用] 旧版固定噪声尺度,已被自适应波动率取代。
